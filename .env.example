# Copy this file to .env and paste your Google AI Studio key in both places.
# Never commit .env.

LLM_PROVIDER="gemini"
LLM_MODEL="gemini/gemini-3.1-flash-lite"
LLM_API_KEY="paste-your-key-here"

EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="gemini/gemini-embedding-001"
EMBEDDING_API_KEY="paste-your-key-here"
EMBEDDING_DIMENSIONS="768"

# Free tier is roughly 15 requests per minute, so pace every call.
LLM_RATE_LIMIT_ENABLED="true"
LLM_RATE_LIMIT_REQUESTS="13"
LLM_RATE_LIMIT_INTERVAL="60"
